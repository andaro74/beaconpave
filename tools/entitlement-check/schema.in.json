{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://beaconpave/tools/entitlement-check/schema.in.json",
  "title": "entitlement-check input",
  "description": "Consequence class: read. The authoritative verdict on whether one viewer, on one plan, in one market, may watch one title at this moment, and the reason when they may not.",
  "type": "object",
  "required": ["title_id", "plan", "dma"],
  "additionalProperties": false,
  "properties": {
    "title_id": { "type": "string", "pattern": "^t[0-9]{3}$" },
    "plan": { "type": "string", "enum": ["base", "sports-tier"] },
    "dma": {
      "type": "string",
      "enum": ["jefferson-city", "port-william", "north-haven", "lake-adair", "granite-falls", "cedar-point"]
    }
  }
}
