{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://beaconpave/tools/catalog-search/schema.out.json",
  "title": "catalog-search output",
  "description": "Catalog rows only. This tool never decides entitlement or blackout — that is entitlement-check's job, and splitting them is what makes the trajectory eval (`expect_tool_before_answer`) meaningful at M06.",
  "type": "object",
  "required": ["results"],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "brand", "type", "entitlement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "brand": { "type": "string", "enum": ["meridian-sports", "meridian-news"] },
          "type": { "type": "string", "enum": ["live-event", "live-linear", "vod"] },
          "entitlement": { "type": "string", "enum": ["base", "sports-tier"] },
          "event": { "type": "string" },
          "starts": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
